---
// Project page shell — design-system layout for a rendered PHDS document:
// breadcrumb-style back link, title, metadata block, then documentation prose.
// Deeper project-page UX (readability refinements) is Droplet 0.1.4.3.
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import MetadataBlock from '../components/MetadataBlock.astro';
import type { ProjectMetadata } from '../lib/metadata';

interface Props {
  project: ProjectMetadata;
}

const { project } = Astro.props;
---

<BaseLayout title={project.title} description={`${project.title} — engineering project documentation.`}>
  <Container width="content">
    <p class="back"><a href="/#projects">← All projects</a></p>
    <article>
      <header>
        <h1>{project.title}</h1>
        <MetadataBlock project={project} />
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
  </Container>
</BaseLayout>

<style>
  .back {
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }

  .back a {
    color: var(--color-text-secondary);
  }

  .back a:hover {
    color: var(--color-primary);
  }
</style>
