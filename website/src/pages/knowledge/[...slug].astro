---
import { getCollection, render } from 'astro:content';
import KnowledgeLayout from '../../layouts/KnowledgeLayout.astro';
import { extractKnowledgeMetadata, knowledgeUrl } from '../../lib/knowledge';
import { extractMetadata } from '../../lib/metadata';
import { projectUrl } from '../../lib/url-generator';

// One static route per knowledge article folder discovered under knowledge/.
// Related-content links resolve against the real collections, so only targets
// that actually exist are rendered (knowledge ↔ project relationship foundation).
export async function getStaticPaths() {
  const [articles, projects] = await Promise.all([
    getCollection('knowledge'),
    getCollection('projects'),
  ]);
  const projectTitles = new Map(projects.map((p) => [p.id, extractMetadata(p).title]));
  const articleTitles = new Map(articles.map((a) => [a.id, a.data.title]));

  return articles.map((entry) => {
    const meta = extractKnowledgeMetadata(entry);
    return {
      params: { slug: entry.id },
      props: {
        entry,
        relatedProjects: meta.relatedProjects
          .filter((slug) => projectTitles.has(slug))
          .map((slug) => ({ title: projectTitles.get(slug) ?? slug, url: projectUrl(slug) })),
        relatedKnowledge: meta.relatedKnowledge
          .filter((slug) => slug !== entry.id && articleTitles.has(slug))
          .map((slug) => ({ title: articleTitles.get(slug) ?? slug, url: knowledgeUrl(slug) })),
      },
    };
  });
}

const { entry, relatedProjects, relatedKnowledge } = Astro.props;
// Render the article body to HTML; headings feed the table of contents.
const { Content, headings } = await render(entry);
const article = extractKnowledgeMetadata(entry);
// Reading time at ~220 words/min from the raw markdown body.
const words = entry.body ? entry.body.split(/\s+/).length : 0;
const readingMinutes = words > 0 ? Math.max(1, Math.round(words / 220)) : undefined;
---

<KnowledgeLayout {article} {headings} {readingMinutes} {relatedProjects} {relatedKnowledge}>
  <Content />
</KnowledgeLayout>
