---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Tag from '../components/Tag.astro';
import { buildContentIndex } from '../lib/content-index';
import { sortByRecency } from '../lib/metadata';
import { siteProfile } from '../lib/profile';

// Portfolio (Droplet 0.1.4.5) — the public engineering identity: profile,
// featured work, project highlights, and the road ahead. Not a résumé — a
// gateway into documented work, and the seed of future creator profiles.
const { projects, count, knowledgeCount, tags } = await buildContentIndex();

const recent = sortByRecency(projects);
// Featured Work: curated via the `featured` frontmatter flag; if nothing is
// curated yet, fall back to the most recent project so the section never dies.
const featured = recent.filter((p) => p.featured);
const featuredWork = featured.length > 0 ? featured : recent.slice(0, 1);
const highlights = recent.slice(0, 5);
const topicCount = Object.keys(tags).length;

const futureCapabilities = [
  { name: 'Blog publishing', detail: 'narrative write-ups derived from project documentation' },
  { name: 'Knowledge publishing', detail: 'a growing library of reusable engineering concepts' },
  { name: 'Creator portfolios', detail: 'public profiles for engineers who document their work' },
  { name: 'Community contributions', detail: 'shared learning across documented projects' },
];
---

<BaseLayout
  title="Portfolio"
  description={`${siteProfile.name} — ${siteProfile.headline} Documented engineering work: projects, debugging journeys, and lessons learned.`}
>
  <Container>
    <!-- Engineering profile — who creates this work and why it's published -->
    <section class="profile">
      <p class="eyebrow">Engineering portfolio</p>
      <h1>{siteProfile.name}</h1>
      <p class="headline">{siteProfile.headline}</p>
      <p class="mission">{siteProfile.mission}</p>
      <div class="disciplines">
        {siteProfile.disciplines.map((d) => <Tag label={d} linked={false} />)}
      </div>
      <p class="profile-meta">
        Currently exploring: {siteProfile.exploring.join(' · ')}
      </p>
      <p class="profile-links">
        {siteProfile.links.map((link) => (
          <a href={link.url}>{link.label} →</a>
        ))}
      </p>
    </section>

    <!-- Featured work — curated via the `featured` frontmatter flag -->
    <Section
      title="Featured Work"
      description="Selected projects — the builds that best show the documented engineering path."
    >
      <div class="featured-grid">
        {featuredWork.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </Section>

    <!-- Project highlights — quick overview of engineering activity -->
    <Section title="Project Highlights">
      <p class="stats">
        <strong>{count}</strong> documented project{count === 1 ? '' : 's'} ·
        <strong>{knowledgeCount}</strong> knowledge article{knowledgeCount === 1 ? '' : 's'} ·
        <strong>{topicCount}</strong> topics
      </p>
      <ul class="highlights">
        {highlights.map((project) => (
          <li>
            <a href={project.url}>{project.title}</a>
            <span class="meta">
              <StatusBadge status={project.status} />
              {project.dateSealed && project.dateSealed !== 'unknown' && (
                <span class="date">{project.dateSealed}</span>
              )}
            </span>
          </li>
        ))}
      </ul>
      <p class="all-link"><a href="/projects">All projects →</a></p>
    </Section>

    <!-- The road ahead — future platform capabilities (informational, V0.1) -->
    <Section
      title="The Road Ahead"
      description="Project Hub is built to grow beyond a personal notebook. Planned for future versions:"
    >
      <ul class="future">
        {futureCapabilities.map((item) => (
          <li>
            <strong>{item.name}</strong> — {item.detail}
          </li>
        ))}
      </ul>
    </Section>
  </Container>
</BaseLayout>

<style>
  /* Engineering profile */
  .profile {
    padding: var(--space-12) 0 var(--space-16);
    max-width: 56rem;
  }

  .eyebrow {
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  .profile h1 {
    margin-bottom: var(--space-2);
  }

  .headline {
    font-size: var(--text-lg);
    color: var(--color-text);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .mission {
    color: var(--color-text-secondary);
    max-width: 44rem;
    margin-bottom: var(--space-6);
  }

  .disciplines {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .profile-meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }

  .profile-links {
    margin: 0;
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* Featured work */
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Project highlights */
  .stats {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .stats strong {
    color: var(--color-text);
  }

  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 46rem;
  }

  .highlights li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .highlights li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .highlights a {
    font-weight: 500;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .highlights a:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .highlights .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .highlights .date {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .all-link {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* Future capabilities */
  .future {
    list-style: none;
    margin: 0;
    padding: var(--space-6);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    max-width: 46rem;
  }

  .future li {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .future li:last-child {
    margin-bottom: 0;
  }

  .future strong {
    color: var(--color-text);
  }
</style>
