---
import { buildContentIndex } from '../lib/content-index';

// Metadata-driven project listing — rendered from the generated content index.
const { projects, count } = await buildContentIndex();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Project Hub</title>
  </head>
  <body>
    <main>
      <h1>Project Hub</h1>
      <p>{count} project{count === 1 ? '' : 's'} published from <code>content/</code>.</p>

      {
        projects.length === 0 ? (
          <p>No projects published yet.</p>
        ) : (
          <ul>
            {projects.map((project) => (
              <li>
                <a href={project.url}>{project.title}</a>
                <span> — {project.status}</span>
                {project.tags.length > 0 && <span> · {project.tags.slice(0, 5).join(', ')}</span>}
              </li>
            ))}
          </ul>
        )
      }
    </main>
  </body>
</html>
