---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { buildContentIndex } from '../lib/content-index';

// Metadata-driven project listing on the design system.
// The full landing experience (hero, overviews, portfolio intro) is Droplet 0.1.4.2.
const { projects, count } = await buildContentIndex();
---

<BaseLayout title="Project Hub">
  <Container>
    <div id="projects">
      <Section
        title="Projects"
        description={`${count} engineering project${count === 1 ? '' : 's'} — documented, preserved, and published from Obsidian.`}
      >
        {
          projects.length === 0 ? (
            <p>No projects published yet.</p>
          ) : (
            <div class="grid">
              {projects.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          )
        }
      </Section>
    </div>
  </Container>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
