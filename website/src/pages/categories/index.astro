---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import { buildContentIndex } from '../../lib/content-index';

// Category index (Droplet 0.1.5.3) — high-level knowledge domains. Categories
// provide structure; tags provide connections.
const { categoryRegistry } = await buildContentIndex();
---

<BaseLayout
  title="Categories"
  description="Browse Project Hub by knowledge domain — categories across projects and knowledge articles."
>
  <Container>
    <Section
      title="Categories"
      description={`${categoryRegistry.length} knowledge domain${categoryRegistry.length === 1 ? '' : 's'}. Categories provide structure; tags provide connections.`}
    >
      {
        categoryRegistry.length === 0 ? (
          <p>No categories yet.</p>
        ) : (
          <div class="grid">
            {categoryRegistry.map((record) => (
              <a class="cat-card" href={record.url}>
                <h3>{record.category}</h3>
                <p>
                  {record.projects.length} project{record.projects.length === 1 ? '' : 's'} ·{' '}
                  {record.knowledge.length} article{record.knowledge.length === 1 ? '' : 's'}
                </p>
              </a>
            ))}
          </div>
        )
      }
    </Section>
  </Container>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .cat-card {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: var(--space-4);
  }

  .cat-card:hover {
    border-color: var(--color-primary);
    text-decoration: none;
  }

  .cat-card h3 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2);
    color: var(--color-text);
  }

  .cat-card:hover h3 {
    color: var(--color-primary);
  }

  .cat-card p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin: 0;
  }
</style>
