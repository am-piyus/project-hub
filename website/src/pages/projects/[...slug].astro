---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { extractMetadata, sortByRecency } from '../../lib/metadata';

// One static route per project folder discovered under content/.
// prev/next walk the recency-sorted project sequence (newer ← → older).
export async function getStaticPaths() {
  const entries = await getCollection('projects');
  const ordered = sortByRecency(entries.map(extractMetadata));
  return entries.map((entry) => {
    const index = ordered.findIndex((p) => p.slug === entry.id);
    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: index > 0 ? ordered[index - 1] : undefined,
        next: index < ordered.length - 1 ? ordered[index + 1] : undefined,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
// Render the PHDS markdown body to HTML; headings feed the table of contents.
const { Content, headings } = await render(entry);
const project = extractMetadata(entry);
// Reading time at ~220 words/min from the raw markdown body.
const words = entry.body ? entry.body.split(/\s+/).length : 0;
const readingMinutes = words > 0 ? Math.max(1, Math.round(words / 220)) : undefined;
---

<ProjectLayout {project} {headings} {readingMinutes} {prev} {next}>
  <Content />
</ProjectLayout>
