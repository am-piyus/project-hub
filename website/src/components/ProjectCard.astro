---
// Project card — one project in a listing grid. Consumes the Publishing
// Engine's extracted metadata (src/lib/metadata.ts) without manual wiring.
import type { ProjectMetadata } from '../lib/metadata';
import StatusBadge from './StatusBadge.astro';
import Tag from './Tag.astro';

interface Props {
  project: ProjectMetadata;
}

const { project } = Astro.props;
const visibleTags = project.tags.slice(0, 4);
---

<article class="card">
  <header>
    <h3><a href={project.url}>{project.title}</a></h3>
    <StatusBadge status={project.status} />
  </header>
  {project.summary && <p class="summary">{project.summary}</p>}
  {
    visibleTags.length > 0 && (
      <p class="tags">
        {visibleTags.map((tag) => (
          <Tag label={tag} />
        ))}
      </p>
    )
  }
  {project.dateSealed && project.dateSealed !== 'unknown' && (
    <p class="date">Sealed {project.dateSealed}</p>
  )}
</article>

<style>
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: var(--space-4);
    transition: border-color 120ms ease;
  }

  .card:hover {
    border-color: var(--color-border-strong);
  }

  header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  h3 {
    font-size: var(--text-lg);
    margin: 0;
    overflow-wrap: anywhere;
  }

  h3 a {
    color: var(--color-text);
  }

  h3 a:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .summary {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-3);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
  }

  .date {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin: 0;
  }
</style>
