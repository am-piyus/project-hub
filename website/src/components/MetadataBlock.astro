---
// Metadata block — presents a project's PHDS metadata consistently at the top
// of a project page: status, dates, sources, AI systems, and tags.
import type { ProjectMetadata } from '../lib/metadata';
import StatusBadge from './StatusBadge.astro';
import Tag from './Tag.astro';

interface Props {
  project: ProjectMetadata;
}

const { project } = Astro.props;

const rows: Array<{ label: string; value: string }> = [];
if (project.dateStarted && project.dateStarted !== 'unknown')
  rows.push({ label: 'Started', value: project.dateStarted });
if (project.dateSealed && project.dateSealed !== 'unknown')
  rows.push({ label: 'Sealed', value: project.dateSealed });
if (project.sources.length > 0) rows.push({ label: 'Sources', value: project.sources.join(', ') });
if (project.aiSystems.length > 0)
  rows.push({ label: 'AI systems', value: project.aiSystems.join(', ') });
---

<div class="metadata">
  <div class="status-row">
    <StatusBadge status={project.status} />
    {rows.map((row) => (
      <span class="row">
        <span class="label">{row.label}</span>
        {row.value}
      </span>
    ))}
  </div>
  {
    project.tags.length > 0 && (
      <div class="tags">
        {project.tags.map((tag) => (
          <Tag label={tag} />
        ))}
      </div>
    )
  }
</div>

<style>
  .metadata {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4);
    margin: var(--space-6) 0;
  }

  .status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .row {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .label {
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    margin-right: var(--space-1);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }
</style>
