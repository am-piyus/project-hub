---
// Table of contents — left sidebar listing the document's sections (PHDS h2
// headings) with current-section highlighting while scrolling. Sticky on
// desktop; collapses into an "On this page" disclosure on smaller screens.
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
---

{
  sections.length > 1 && (
    <>
      {/* Mobile: collapsible list above the document */}
      <details class="toc-mobile">
        <summary>On this page</summary>
        <ul>
          {sections.map((section) => (
            <li>
              <a href={`#${section.slug}`}>{section.text}</a>
            </li>
          ))}
        </ul>
      </details>

      {/* Desktop: sticky left sidebar with scroll-spy highlight */}
      <nav class="toc" data-toc aria-label="Table of contents">
        <p class="toc-title">On this page</p>
        <ul>
          {sections.map((section) => (
            <li>
              <a href={`#${section.slug}`}>{section.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </>
  )
}

<script>
  // Scroll-spy: highlight the TOC entry of the section currently in view.
  const toc = document.querySelector('[data-toc]');
  if (toc) {
    const links = new Map<Element, Element>();
    for (const link of toc.querySelectorAll('a')) {
      const id = decodeURIComponent((link.getAttribute('href') ?? '').slice(1));
      const heading = document.getElementById(id);
      if (heading) links.set(heading, link);
    }
    let current: Element | undefined;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            current?.classList.remove('active');
            current = links.get(entry.target);
            current?.classList.add('active');
            break;
          }
        }
      },
      // Activate when a heading enters the upper third of the viewport.
      { rootMargin: '-72px 0px -66% 0px' },
    );
    for (const heading of links.keys()) observer.observe(heading);
  }
</script>

<style>
  /* Desktop sidebar */
  .toc {
    display: none;
  }

  @media (min-width: 64rem) {
    .toc {
      display: block;
      position: sticky;
      top: 4.5rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
      padding-right: var(--space-3);
      font-size: var(--text-sm);
    }
  }

  .toc-title {
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--color-border);
  }

  .toc li {
    margin: 0;
  }

  .toc a {
    display: block;
    padding: var(--space-1) 0 var(--space-1) var(--space-3);
    margin-left: -2px;
    border-left: 2px solid transparent;
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .toc a:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .toc a.active {
    color: var(--color-primary);
    border-left-color: var(--color-primary);
    font-weight: 600;
  }

  /* Mobile disclosure */
  .toc-mobile {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }

  @media (min-width: 64rem) {
    .toc-mobile {
      display: none;
    }
  }

  .toc-mobile summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text);
  }

  .toc-mobile ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
  }

  .toc-mobile li {
    margin-bottom: var(--space-2);
  }
</style>
