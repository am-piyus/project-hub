---
// Footer — site identity, source link, and quiet credits.
// Footer navigation columns are expanded by the Navigation System (0.1.4.6).
---

<footer class="site-footer">
  <div class="inner">
    <p class="brand">Project Hub</p>
    <p class="tagline">
      Engineering knowledge — documented, preserved, and published from Obsidian.
    </p>
    <p class="meta">
      <a href="https://github.com/am-piyus/project-hub">GitHub</a> · Built with the UPDS
      documentation workflow
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: var(--space-8) 0;
    margin-top: var(--space-16);
  }

  .inner {
    max-width: var(--width-wide);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .brand {
    font-weight: 700;
    margin-bottom: var(--space-1);
  }

  .tagline {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }

  .meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin: 0;
  }
</style>
