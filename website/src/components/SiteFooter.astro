---
// Footer (Droplet 0.1.4.6) — secondary navigation, platform information, and
// quiet credits. Future expansion (social, community, profile links) extends
// the columns without redesigning the footer.
import { withBase } from '../lib/url-generator';

const year = new Date().getFullYear();

const exploreLinks = [
  { label: 'Home', href: withBase('/') },
  { label: 'Projects', href: withBase('/projects') },
  { label: 'Knowledge', href: withBase('/knowledge') },
  { label: 'Portfolio', href: withBase('/portfolio') },
];

const platformLinks = [
  { label: 'GitHub repository', href: 'https://github.com/am-piyus/project-hub' },
];
---

<footer class="site-footer">
  <div class="inner">
    <div class="cols">
      <div class="brand-col">
        <p class="brand">Project Hub</p>
        <p class="tagline">
          Engineering knowledge — documented, preserved, and published from Obsidian.
        </p>
      </div>
      <nav aria-label="Footer — explore">
        <p class="col-title">Explore</p>
        <ul>
          {exploreLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Footer — platform">
        <p class="col-title">Platform</p>
        <ul>
          {platformLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
          <li class="muted">Built with the UPDS documentation workflow</li>
        </ul>
      </nav>
    </div>
    <p class="meta">© {year} Project Hub</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: var(--space-8) 0 var(--space-6);
    margin-top: var(--space-16);
  }

  .inner {
    max-width: var(--width-wide);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 40rem) {
    .cols {
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .brand {
    font-weight: 700;
    margin-bottom: var(--space-1);
  }

  .tagline {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    margin: 0;
    max-width: 36ch;
  }

  .col-title {
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }

  li a {
    color: var(--color-text-secondary);
  }

  li a:hover {
    color: var(--color-primary);
  }

  .muted {
    color: var(--color-text-muted);
  }

  .meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
</style>
