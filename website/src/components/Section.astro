---
// Section container — consistent vertical rhythm with an optional titled header.
interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<section class="section">
  {
    title && (
      <header class="section-header">
        <h2>{title}</h2>
        {description && <p>{description}</p>}
      </header>
    )
  }
  <slot />
</section>

<style>
  .section {
    margin-bottom: var(--space-12);
  }

  .section-header {
    margin-bottom: var(--space-6);
  }

  .section-header h2 {
    margin-bottom: var(--space-2);
  }

  .section-header p {
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 60ch;
  }
</style>
