---
// Global navigation (Droplet 0.1.4.6) — site identity, primary section links
// with current-section highlighting, the color-theme toggle, and a responsive
// mobile menu. Add future sections (Search, Tags, Blog, Profiles) to NAV_ITEMS;
// the architecture needs no redesign to grow.
import { withBase } from '../lib/url-generator';

const NAV_ITEMS = [
  { label: 'Home', href: withBase('/') },
  { label: 'Projects', href: withBase('/projects') },
  { label: 'Knowledge', href: withBase('/knowledge') },
  { label: 'Portfolio', href: withBase('/portfolio') },
  { label: 'Search', href: withBase('/search') },
];

const path = Astro.url.pathname;
const home = withBase('/');
const isActive = (href: string) =>
  href === home
    ? path === home || path === withBase('')
    : path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href={withBase('/')}>Project<span>Hub</span></a>
    <div class="right">
      <button
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Menu"
      >
        <svg class="open-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
        <svg class="close-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
      <button id="theme-toggle" type="button" aria-label="Toggle color theme">
        <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
        </svg>
        <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
    </div>
    <nav id="primary-nav" aria-label="Primary">
      {
        NAV_ITEMS.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  // Mobile menu disclosure
  const navToggle = document.getElementById('nav-toggle');
  const header = document.querySelector('.site-header');
  navToggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('menu-open') ?? false;
    navToggle.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .inner {
    max-width: var(--width-wide);
    margin: 0 auto;
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .brand {
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .brand span {
    color: var(--color-primary);
  }

  .brand:hover {
    text-decoration: none;
  }

  .right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  nav {
    display: flex;
    gap: var(--space-6);
  }

  nav a {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-1) 0;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  /* Where am I? — current section highlight */
  nav a[aria-current='page'] {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
    font-weight: 600;
  }

  #theme-toggle,
  #nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  #theme-toggle:hover,
  #nav-toggle:hover {
    color: var(--color-primary);
    border-color: var(--color-border-strong);
  }

  /* Theme toggle: show the icon for the theme you would switch TO */
  .moon { display: block; }
  .sun { display: none; }

  :global([data-theme='dark']) .moon { display: none; }
  :global([data-theme='dark']) .sun { display: block; }

  /* Desktop: inline nav between brand and controls; no menu button */
  #nav-toggle {
    display: none;
  }

  @media (min-width: 40rem) {
    nav {
      order: 0;
    }

    .right {
      order: 1;
    }

    .inner {
      flex-wrap: nowrap;
    }

    nav {
      margin-left: auto;
      margin-right: var(--space-6);
    }
  }

  /* Mobile: hamburger disclosure — nav drops to a full-width column */
  @media (max-width: 39.99rem) {
    #nav-toggle {
      display: inline-flex;
    }

    .close-icon { display: none; }

    :global(.site-header.menu-open) .open-icon { display: none; }
    :global(.site-header.menu-open) .close-icon { display: block; }

    nav {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: var(--space-1);
      padding: var(--space-2) 0 var(--space-1);
      border-top: 1px solid var(--color-border);
      margin-top: var(--space-2);
    }

    :global(.site-header.menu-open) nav {
      display: flex;
    }

    nav a {
      padding: var(--space-2) 0;
      border-bottom: none;
    }

    nav a[aria-current='page'] {
      border-bottom: none;
    }
  }
</style>
