---
// Tag chip — topic/technology label. Since Droplet 0.1.5.2 a tag is a
// navigable discovery path: it links to its generated /tags page. Pass
// `linked={false}` for decorative labels that are not content tags
// (e.g. portfolio disciplines).
import { tagUrl } from '../lib/discovery';

interface Props {
  label: string;
  linked?: boolean;
}

const { label, linked = true } = Astro.props;
---

{
  linked ? (
    <a class="tag" href={tagUrl(label)}>{label}</a>
  ) : (
    <span class="tag">{label}</span>
  )
}

<style>
  .tag {
    display: inline-block;
    font-size: var(--text-sm);
    line-height: 1;
    color: var(--color-text-secondary);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  a.tag:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    text-decoration: none;
  }
</style>
